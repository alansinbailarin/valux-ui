{
  "name": "valux-ui",
  "version": "0.1.0",
  "description": "Accessible React components for modern Next.js applications.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "llms.txt",
    "llms-full.txt",
    "docs/getting-started.md",
    "docs/components",
    "docs/motion.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./transitions": {
      "import": {
        "types": "./dist/transitions.d.ts",
        "default": "./dist/transitions.js"
      },
      "require": {
        "types": "./dist/transitions.d.cts",
        "default": "./dist/transitions.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev",
    "build": "tsdown && node scripts/copy-styles.mjs",
    "build:demo": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:contract": "node scripts/verify-package.mjs",
    "verify:conditions": "node scripts/verify-conditions.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "pack:check": "pnpm pack --dry-run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm package:contract && pnpm verify:conditions && pnpm publint && pnpm pack:check",
    "prepublishOnly": "pnpm verify",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "docs:llms": "node scripts/build-llms.mjs"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@heroicons/react": "^2.2.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.12.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "next": "16.2.10",
    "publint": "^0.3.21",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4",
    "tsdown": "^0.22.5",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "browserslist": [
    "iOS >= 13",
    "Safari >= 13",
    "Chrome >= 80",
    "Firefox >= 78",
    "Edge >= 80"
  ],
  "dependencies": {
    "lucide-react": "^1.47.0"
  }
}
